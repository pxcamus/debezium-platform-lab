# Local environment / secrets (never commit)
.env
.env.*.local
# but keep the committed template (a global ~/.gitignore may ignore .env*)
!.env.example
*.kubeconfig
kubeconfig*
# Per-release secret overlays (real hosts, tokens, htpasswd hashes)
deploy/values/**/*.secret.yaml

# Symlinked / external working dirs
# `notes` is a symlink into the private oneint_docs repo. `docs/` is the public
# MkDocs site in this repo and must stay tracked — do not ignore it. `examples`
# used to be a symlink too; it is now a real, tracked directory holding the
# component selections the guides are written against, so it is NOT ignored.
/kafka/
/notes
/thorin

# Rendered MkDocs output
/site
# goreleaser build output (`goreleaser release --snapshot`)
/dist
# Docs toolchain virtualenv, created on demand by `mage docs:serve` / `docs:build`
/.venv

# Helm subchart tarballs, fetched on demand.
#
# `helm dependency update/build` writes dependencies into a chart's charts/ directory,
# and helmfile runs that build itself before every template/diff/apply — so a committed
# tarball is refetched content, not a source. Chart.yaml pins the version and Chart.lock
# records the digest, which is what actually makes the dependency reproducible; the blob
# only made version bumps show up as a delete-plus-add of a binary.
#
# Local path dependencies (deploy/charts/debezium-platform/charts/database) are
# directories, not tarballs, so they stay tracked.
deploy/charts/**/charts/*.tgz

# IDE
.idea/

# OS
.DS_Store
