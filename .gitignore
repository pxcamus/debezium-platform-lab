# Local environment / secrets (never commit)
.env
.env.*.local
# but keep the committed template (a global ~/.gitignore may ignore .env*)
!.env.example
*.kubeconfig
kubeconfig*
# Per-release secret overlays (real hosts, tokens, htpasswd hashes)
deploy/values/**/*.secret.yaml

# Symlinked / external working dirs
# `notes` is a symlink into the private oneint_docs repo. `docs/` is the public
# MkDocs site in this repo and must stay tracked — do not ignore it.
examples
/kafka/
/notes
/thorin

# Rendered MkDocs output
/site
# Docs toolchain virtualenv, created on demand by `mage docs:serve` / `docs:build`
/.venv

# IDE
.idea/

# OS
.DS_Store
