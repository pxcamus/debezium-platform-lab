# =============================================================================
# debezium-platform-lab — environment configuration
# -----------------------------------------------------------------------------
#     cp .env.example .env
#
# This file is the minimum needed for the local Kind demo. Every variable here
# either has no default anywhere, or has a default that is wrong when you run
# from your workstation. Everything else is documented in
# docs/reference/environment.md — you do not need to copy it here.
#
# `.env` is loaded first (git-ignored — put secrets and host overrides there),
# then deploy/environment/versions.env as a fallback for shared version pins
# (DPL_DEBEZIUM_VERSION, DPL_NAMESPACE, image tags). Do not duplicate pins here.
# Values below are non-secret demo defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Cluster
# -----------------------------------------------------------------------------
# Cluster provider: kind | k3s
DPL_CLUSTER_TYPE=kind

# --- k3s host access (DPL_CLUSTER_TYPE=k3s only) -----------------------------
# Where the cluster lives and how to reach it. Not read by helmfile — only by
# `just cluster-recreate` and the kubeconfig fetch that follows it. Commented
# out because the Kind demo has no use for them.
#
# These describe the MACHINE, not a particular guide, which is why they live
# here and not in examples/<guide>/.env.example: one host serves every example
# you deploy onto it, and the values should not move when you switch guides.
#
# The unprefixed K3S_* spellings are retired — scripts/validate-env.sh rejects
# them in tracked files and scripts/lib/env.sh warns if they are exported.
# DPL_K3S_HOST=dmp-demo                                # ssh target: host, alias or IP
# DPL_K3S_SSH_USER=root                                # Hetzner default; AWS AMIs use ec2-user
# DPL_K3S_SSH_KEY=~/.ssh/dmp-demo                      # private key for the user above
# DPL_K3S_REMOTE_KUBECONFIG=/etc/rancher/k3s/k3s.yaml  # where k3s writes it on the node
# DPL_K3S_LOCAL_KUBECONFIG=~/.kube/dmp-demo.yaml       # where to copy it locally
# DPL_K3S_CONTEXT=dmp-demo                             # context name after the copy

# Deployment environment; selects deploy/values/<component>/<DPL_ENV>.yaml.gotmpl.
# Known values: local | public. Use `local` for the Kind demo.
DPL_ENV=local

# Base DNS zone. Each component appends its own subdomain: dmp.${DPL_DOMAIN},
# apicurio.${DPL_DOMAIN}, kafbat.${DPL_DOMAIN}. Rendered with `requiredEnv`, so
# there is no default — helmfile fails if it is unset.
#
# sslip.io resolves any *.127-0-0-1.sslip.io name to 127.0.0.1, which is where
# the Kind node publishes ports 80 and 443 (deploy/clusters/kind/kind-ingress.yaml).
# So the default below needs no /etc/hosts entries and no sudo. This is the same
# trick scripts/lab/hcloud-up.sh prints for the Hetzner lab, in the same notation.
#
# It does need working internet DNS. Check with:
#     dig +short dmp.127-0-0-1.sslip.io      # expect: 127.0.0.1
#
# If that returns nothing or a different address, your resolver is filtering
# public answers that point at loopback (DNS rebinding protection — common with
# Pi-hole, some routers and corporate DNS). Same story if you are offline. In
# that case pick a private zone and map it by hand:
#
#     DPL_DOMAIN=platform.debezium.local
#     # sudo tee -a /etc/hosts <<'EOF'
#     # 127.0.0.1 dmp.platform.debezium.local
#     # 127.0.0.1 apicurio.platform.debezium.local
#     # 127.0.0.1 kafbat.platform.debezium.local
#     # EOF
#
# On macOS prefer a suffix other than `.local` if you go that route — `.local`
# is reserved for mDNS/Bonjour and is intercepted by mDNSResponder.
DPL_DOMAIN=127-0-0-1.sslip.io

# -----------------------------------------------------------------------------
# Data seeding — see resources/data/
# -----------------------------------------------------------------------------
# Seeding runs from your workstation, so the addresses below assume a
# port-forward to the in-cluster databases rather than in-cluster service names.
# Credentials for the demo databases are app_owner/app_owner on `ecommerce`.
DPL_MONGODB_URI=mongodb://127.0.0.1:27017
DPL_MONGODB_DIRECT_CONNECTION=true
DPL_POSTGRESQL_HOST=127.0.0.1

# =============================================================================
# DMP scenarios — see data-pipelines/config/
# -----------------------------------------------------------------------------
# These are expanded into the JSON payloads under data-pipelines/config/. A missing
# variable becomes an empty string rather than an error, so an unset value here
# produces a broken DMP resource, not a failed run.
# The addresses assume the charts in this repo.
# =============================================================================

# Prefix + environment used to build deterministic DMP resource names:
#   ${DPL_DMP_RESOURCE_PREFIX}-${DPL_DMP_ENVIRONMENT}-<resource-type>
DPL_DMP_RESOURCE_PREFIX=oneint
DPL_DMP_ENVIRONMENT=local

# --- MongoDB source connection (in-cluster) ---------------------------------
DPL_DMP_MONGODB_CONNECTION_STRING=mongodb://debezium:debezium@mongodb-2.mongodb-svc.databases.svc.cluster.local:27017/admin?authSource=admin&replicaSet=mongodb&serverSelectionTimeoutMS=2000

# --- PostgreSQL source connection (in-cluster) ------------------------------
DPL_DMP_POSTGRES_HOST=postgresql-rw.databases.svc.cluster.local
DPL_DMP_POSTGRES_PORT=5432
DPL_DMP_POSTGRES_DATABASE=ecommerce
DPL_DMP_POSTGRES_USERNAME=debezium
DPL_DMP_POSTGRES_PASSWORD=debezium

# --- Kafka destination (in-cluster) -----------------------------------------
DPL_DMP_KAFKA_BOOTSTRAP_SERVERS=my-cluster-kafka-bootstrap.kafka:9092

# --- HTTP-server destination (in-cluster) -----------------------------------
DPL_DMP_HTTPSERVER_CONNECTION_STRING=http://http-server.tools.svc.cluster.local

# --- SQL Server source connection -------------------------------------------
# Not on the default path: the mssql release is applied explicitly and requires
# amd64. Uncomment if you are working on the sqlserver scenario.
# DPL_DMP_SQLSERVER_HOSTNAME=mssql.databases.svc.cluster.local
# DPL_DMP_SQLSERVER_DATABASE=ecommerce
# DPL_DMP_SQLSERVER_USERNAME=sa
# DPL_DMP_SQLSERVER_PASSWORD=
# DPL_DMP_SQLSERVER_ENCRYPT=false
# DPL_DMP_SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# -----------------------------------------------------------------------------
# Common overrides — defaults are fine for the local demo. See
# docs/reference/environment.md for the full list.
# -----------------------------------------------------------------------------
# DPL_LOG_LEVEL=info                                     # debug | info | warn | error
# DPL_KIND_CLUSTER_NAME=dmp
# DPL_KIND_CONFIG=deploy/clusters/kind/kind-ingress.yaml
# DPL_DMP_BASE_URL=https://dmp.platform.example.io       # else derived from DPL_DOMAIN
