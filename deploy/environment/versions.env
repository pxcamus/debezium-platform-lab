# Chart pins below carry a `# renovate:` comment, which drives the customManagers
# regex in renovate.json. Keep the comment immediately above the variable it annotates.

# The Debezium Platform chart. Conductor, stage and operator IMAGES are separate and
# track `nightly` on purpose (see below); Renovate leaves those alone.
# renovate: datasource=helm depName=debezium-platform registryUrl=https://charts.debezium.io
DPL_DEBEZIUM_VERSION=3.8.0-alpha1
DPL_ENV=local
DPL_NAMESPACE=dmp
DPL_IMAGE_TAG=nightly
DPL_IMAGE_TAG_CONDUCTOR=nightly

# Image registry per component. Default quay.io; set to registry.${DPL_DOMAIN} in your
# git-ignored .env to serve homelab builds from Zot. Split so conductor (frequent) and
# stage (rare) move independently — mirrors DPL_IMAGE_TAG_CONDUCTOR / DPL_IMAGE_TAG.
DPL_IMAGE_REGISTRY=quay.io
DPL_IMAGE_REGISTRY_CONDUCTOR=quay.io
TIMESTAMP_TEST=2021-09-22T12:00:00Z

# Monitoring stack (homelab only) — see docs/monitoring.md
# renovate: datasource=helm depName=kube-prometheus-stack registryUrl=https://prometheus-community.github.io/helm-charts
DPL_KUBE_PROMETHEUS_STACK_VERSION=87.10.1
# renovate: datasource=helm depName=opentelemetry-operator registryUrl=https://open-telemetry.github.io/opentelemetry-helm-charts
DPL_OTEL_OPERATOR_VERSION=0.118.0

# Identity / SSO (homelab only) — Keycloak via the official Operator.
# The operator and the Keycloak server image are lockstep (the operator pins the
# server image via RELATED_IMAGE_KEYCLOAK), so these two normally match.
# After bumping DPL_KEYCLOAK_OPERATOR_VERSION, re-run scripts/vendor-keycloak-operator.sh.
# No `# renovate:` comment: the operator chart is vendored, so bumping the numbers alone
# changes nothing and a bot PR would look finished when it is not.
DPL_KEYCLOAK_VERSION=26.7.0
DPL_KEYCLOAK_OPERATOR_VERSION=26.7.0

# oauth2-proxy (homelab only) — SSO Phase 3 forward-auth in front of dmp.${DPL_DOMAIN}.
# Chart version (repo oauth2-proxy/oauth2-proxy), not the app version (app 7.15.3).
# renovate: datasource=helm depName=oauth2-proxy registryUrl=https://oauth2-proxy.github.io/manifests
DPL_OAUTH2_PROXY_CHART_VERSION=10.7.0

# PostgreSQL image for the demo CloudNativePG cluster (components.postgres). A full tag,
# not the floating `16`, so a rebuild gets the same server it got last time.
# renovate: datasource=docker depName=ghcr.io/cloudnative-pg/postgresql
DPL_POSTGRESQL_IMAGE=ghcr.io/cloudnative-pg/postgresql:16.15-minimal-trixie

# CDC dashboard (components.cdc-dashboard) — the `serve` mode of pxcamus/oneint-dbz-cdc-app.
# Chart (oci://ghcr.io/pxcamus/charts/cdc) and image (ghcr.io/pxcamus/oneint-dbz-cdc-app)
# are published together from one git tag; the chart's appVersion pins the image, so this
# single number is the only thing to bump.
# renovate: datasource=docker depName=ghcr.io/pxcamus/charts/cdc
DPL_CDC_VERSION=0.3.0
