DPL_DEBEZIUM_VERSION=3.6.0
DPL_ENV=local
DPL_NAMESPACE=dmp
DPL_IMAGE_TAG=nightly
DPL_IMAGE_TAG_CONDUCTOR=nightly

# Image registry per component. Default quay.io; set to registry.${DPL_DOMAIN} in your
# git-ignored .env to serve homelab builds from Zot. Split so conductor (frequent) and
# stage (rare) move independently — mirrors DPL_IMAGE_TAG_CONDUCTOR / DPL_IMAGE_TAG.
DPL_IMAGE_REGISTRY=quay.io
DPL_IMAGE_REGISTRY_CONDUCTOR=quay.io
TIMESTAMP_TEST=2021-09-22T12:00:00Z

# Monitoring stack (homelab only) — see docs/monitoring.md
DPL_KUBE_PROMETHEUS_STACK_VERSION=87.10.1
DPL_OTEL_OPERATOR_VERSION=0.118.0

# Identity / SSO (homelab only) — Keycloak via the official Operator.
# The operator and the Keycloak server image are lockstep (the operator pins the
# server image via RELATED_IMAGE_KEYCLOAK), so these two normally match.
# After bumping DPL_KEYCLOAK_OPERATOR_VERSION, re-run scripts/vendor-keycloak-operator.sh.
DPL_KEYCLOAK_VERSION=26.7.0
DPL_KEYCLOAK_OPERATOR_VERSION=26.7.0

# oauth2-proxy (homelab only) — SSO Phase 3 forward-auth in front of dmp.${DPL_DOMAIN}.
# Chart version (repo oauth2-proxy/oauth2-proxy), not the app version (app 7.15.3).
DPL_OAUTH2_PROXY_CHART_VERSION=10.7.0
