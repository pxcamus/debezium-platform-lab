{{- /* Two orthogonal axes decide what installs:
         DPL_ENV            — HOW to configure: domains, TLS, sizing, ingress controller.
         .Values.components — WHAT to install, supplied by --state-values-file (repeatable).
                              Default false, so a bare invocation is the base install:
                              the platform, its operator and monitoring, nothing else.
       Note --file is NOT repeatable (last one wins, silently), which is why component
       selection rides on state values rather than a second helmfile. */ -}}
{{- $v := .Values | default dict }}
{{- $env    := env "DPL_ENV" | default "local" }}
{{- $local  := eq $env "local" }}
{{- $public := eq $env "public" }}
{{- $ocp := eq $env "ocp" }}
{{- $operatorMode    := env "DPL_OPERATOR_MODE" | default "bundled" }}
{{- $bundledOperator := eq $operatorMode "bundled" }}
{{- $postgres     := dig "components" "postgres"      false $v }}
{{- $mongodb      := dig "components" "mongodb"       false $v }}
{{- $sqlserver    := dig "components" "sqlserver"     false $v }}
{{- $kafka        := dig "components" "kafka"         false $v }}
{{- $kafkaUI      := dig "components" "kafka-ui"      false $v }}
{{- $kafkaConnect := dig "components" "kafka-connect" false $v }}
{{- $httpServer   := dig "components" "http-server"   false $v }}
{{- $cdcDashboard := dig "components" "cdc-dashboard" false $v }}
{{- $apicurio     := dig "components" "apicurio"      false $v }}
{{- $sso          := dig "components" "sso"           false $v }}
{{- $zot          := dig "components" "zot"           false $v }}
{{- $dns01Gandi   := dig "components" "dns01-gandi"   false $v }}
{{- if and $sso (not $public) }}
  {{- fail "components.sso requires DPL_ENV=public — the identity chain needs cert-manager and a ClusterIssuer, and only the public profile installs cert-manager" }}
{{- end }}
{{- if and $dns01Gandi (not $public) }}
  {{- fail "components.dns01-gandi requires DPL_ENV=public — the webhook and ClusterIssuer are useless without the cert-manager the public profile installs" }}
{{- end }}

helmDefaults:
  wait: true
  timeout: 120
  atomic: true

repositories:
  - name: ingress-nginx
    url: https://kubernetes.github.io/ingress-nginx

  - name: jetstack
    url: https://charts.jetstack.io

  - name: cert-manager-webhook-gandi
    url: https://sintef.github.io/cert-manager-webhook-gandi

  - name: kafbat-ui
    url: https://kafbat.github.io/helm-charts

  - name: cloudnative-pg
    url: https://cloudnative-pg.github.io/charts

  - name: mongodb
    url: https://mongodb.github.io/helm-charts

  - name: debezium
    url: https://charts.debezium.io

  - name: project-zot
    url: http://zotregistry.dev/helm-charts

  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts

  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts

  - name: oauth2-proxy
    url: https://oauth2-proxy.github.io/manifests

releases:
  - name: ingress-nginx
    namespace: ingress-nginx
    createNamespace: true
    chart: ingress-nginx/ingress-nginx
    # local only. The public profile runs on k3s, which ships Traefik as its bundled
    # ingress controller — so public Ingresses carry `ingressClassName: traefik` and
    # no controller is installed here. Kind ships nothing, hence nginx.
    installed: {{ $local }}
    labels:
      app: ingress-nginx
      component: ingress
      infra: "true"
    set:
      - name: controller.hostPort.enabled
        value: true

  - name: cert-manager
    namespace: cert-manager
    createNamespace: true
    chart: jetstack/cert-manager
    installed: {{ $public }}
    labels:
      app: cert-manager
      component: cert-manager
      infra: "true"
    values:
      - values/cert-manager/{{ $env }}.yaml

  # DNS-01 for Gandi-hosted zones. On the components axis, not the profile axis:
  # cert-manager is agnostic, but a solver is registrar-specific and cert-manager
  # only ships built-ins for a handful of providers (Route53, CloudDNS, Cloudflare,
  # …) — Gandi is not one, hence an out-of-tree webhook. Readers whose DNS lives
  # elsewhere leave this off and bring their own `letsencrypt-prod` ClusterIssuer;
  # nothing else in the repo changes, because every Certificate references the
  # issuer by name only.
  - name: cert-manager-webhook-gandi
    namespace: cert-manager
    createNamespace: true
    chart: cert-manager-webhook-gandi/cert-manager-webhook-gandi
    installed: {{ $dns01Gandi }}
    labels:
      app: cert-manager-webhook-gandi
      component: cert-manager-webhook-gandi
      infra: "true"
    values:
      - values/cert-manager-webhook-gandi/{{ $env }}.yaml.gotmpl
    needs:
      - cert-manager/cert-manager

  # The other half of the same flag: the ClusterIssuer that dispatches to the
  # webhook above. Split into its own release only because the webhook comes from
  # an upstream chart that does not create one.
  - name: dns01-gandi
    namespace: cert-manager
    createNamespace: true
    chart: ./charts/dns01-gandi
    installed: {{ $dns01Gandi }}
    labels:
      app: dns01-gandi
      component: cert-manager-webhook-gandi
      infra: "true"
    values:
      - values/dns01-gandi/{{ $env }}.yaml.gotmpl
    needs:
      # cert-manager for the ClusterIssuer CRD; the webhook because the issuer
      # registers its ACME account eagerly and the solver should exist by the time
      # the first Certificate is created.
      - cert-manager/cert-manager
      - cert-manager/cert-manager-webhook-gandi

  # OCI registry (zot). Fronted by the ingress controller with the wildcard TLS
  # secret that already lives in the `registry` namespace. The real host + cert
  # secret name + htpasswd hash come from values/zot/public.secret.yaml, which is
  # git-ignored (see .gitignore) and only referenced on the public profile.
  - name: zot
    namespace: registry
    createNamespace: true
    chart: project-zot/zot
    version: 0.1.121
    installed: {{ $zot }}
    # The secret overlay carries the real host and the htpasswd hash, so it is
    # git-ignored (.gitignore: deploy/values/**/*.secret.yaml) and absent from a fresh
    # checkout. Warn rather than Error so `scripts/validate-helm.sh` can render public
    # in CI — structure is what CI validates, credentials are not. A real DEPLOY
    # still needs the file: without it the chart falls back to an open registry.
    missingFileHandler: Warn
    labels:
      app: zot
      component: registry
      infra: "true"
    values:
      - values/zot/{{ $env }}.yaml.gotmpl
{{- if $public }}
      - values/zot/public.secret.yaml
{{- end }}

  - name: strimzi-cluster-operator
    namespace: kafka
    createNamespace: true
    chart: oci://quay.io/strimzi-helm/strimzi-kafka-operator
    installed: {{ $kafka }}
    labels:
      app: strimzi-cluster-operator
      component: kafka-operator
      infra: "true"

  - name: kafka-cluster
    namespace: kafka
    createNamespace: true
    chart: ./charts/kafka-cluster
    installed: {{ $kafka }}
    labels:
      app: kafka-cluster
      component: kafka
      infra: "true"
    needs:
      - kafka/strimzi-cluster-operator

  - name: kafka-connect
    namespace: kafka
    createNamespace: true
    chart: ./charts/kafka-connect
    installed: {{ $kafkaConnect }}
    labels:
      app: kafka-connect
      component: kafka-connect
      infra: "true"
      cdc: "true"
    needs:
      - kafka/kafka-cluster
      - databases/postgresql-cluster

  - name: kafbat-ui
    namespace: kafka
    createNamespace: true
    chart: kafbat-ui/kafka-ui
    installed: {{ $kafkaUI }}
    labels:
      app: kafbat-ui
      component: kafka-ui
      infra: "true"
    values:
      - values/kafbat/values.yaml.gotmpl
{{- if and $sso $kafkaUI }}
      # With SSO on, the oauth2-proxy-kafbat release owns the kafbat host's Ingress and
      # reverse-proxies to this Service. Leaving the chart's own Ingress enabled would
      # publish a second, unauthenticated route to the same backend.
      - values/kafbat/behind-proxy.yaml
{{- end }}
    needs:
      - kafka/kafka-cluster

  - name: cnpg-operator
    namespace: databases
    createNamespace: true
    chart: cloudnative-pg/cloudnative-pg
    installed: {{ and (or $postgres $sso) (not $ocp) }}
    labels:
      app: cnpg-operator
      component: postgres-operator
      infra: "true"

  - name: postgresql-cluster
    namespace: databases
    createNamespace: true
    chart: ./charts/postgresql-cluster
    installed: {{ $postgres }}
    labels:
      app: postgresql-cluster
      component: postgres
      infra: "true"
    values:
      - values/postgresql/{{ $env }}.yaml
    set:
      - name: image
        value: '{{ requiredEnv "DPL_POSTGRESQL_IMAGE" }}'
    {{- if not $ocp }}
    # On OpenShift the operator comes from OperatorHub, not this helmfile.
    needs:
      - databases/cnpg-operator
    {{- end }}

  - name: mongodb-community-operator
    namespace: databases
    createNamespace: true
    chart: mongodb/community-operator
    installed: {{ $mongodb }}
    labels:
      app: mongodb-community-operator
      component: mongodb-operator
      infra: "true"
    values:
      - values/mongodb/values.yaml

  - name: mongodb-replica-set
    namespace: databases
    createNamespace: true
    chart: ./charts/mongodb-replica-set
    installed: {{ $mongodb }}
    labels:
      app: mongodb-replica-set
      component: mongodb
      infra: "true"
    needs:
      - databases/mongodb-community-operator

  - name: mssql
    namespace: databases
    createNamespace: true
    chart: ./charts/mssql
    installed: {{ $sqlserver }}
    labels:
      app: mssql
      component: mssql
      infra: "false"
    values:
      - values/mssql/{{ $env }}.yaml

  - name: http-server
    namespace: tools
    createNamespace: true
    chart: ./charts/http-server
    installed: {{ $httpServer }}
    labels:
      app: http-server
      component: mock-server
      infra: "true"
    values:
      - values/http-server/{{ $env }}.yaml

  - name: apicurio-registry
    namespace: apicurio
    createNamespace: true
    chart: ./charts/apicurio-registry
    installed: {{ $apicurio }}
    labels:
      app: apicurio-registry
      component: schema-registry
      infra: "false"
    values:
      - values/apicurio/{{ $env }}.yaml.gotmpl
    needs:
      - databases/postgresql-cluster

  # Monitoring foundation, installed on every profile. Both are labelled infra:true
  # so the `--selector infra=true` batch installs them (and their ServiceMonitor /
  # OpenTelemetryCollector CRDs) BEFORE debezium-platform.
  #
  # kube-prometheus-stack ships very large CRDs; the repo-wide helmDefaults
  # (wait+atomic, timeout 120) can time out or hit the client-side
  # "metadata.annotations: Too long" limit on first install. We bump timeout
  # here; if the annotation error appears, install once with `--server-side`.
  - name: kube-prometheus-stack
    namespace: monitoring
    createNamespace: true
    chart: prometheus-community/kube-prometheus-stack
    version: '{{ requiredEnv "DPL_KUBE_PROMETHEUS_STACK_VERSION" }}'
    installed: true
    missingFileHandler: Warn
    timeout: 600
    labels:
      app: kube-prometheus-stack
      component: monitoring
      infra: "true"
    values:
      - values/kube-prometheus-stack/{{ $env }}.yaml.gotmpl
{{- if $local }}
    # Grafana's Ingress must not be created while nginx's admission webhook is
    # registered but its controller is still starting — the API server calls the
    # webhook, gets connection refused, and atomic rolls the whole stack back.
    # helmDefaults.wait makes this edge sufficient: nginx is Ready, not merely applied.
    # Guarded by the same condition as the ingress-nginx release itself: an edge to a
    # disabled release is not reliably a no-op. public fronts with k3s's Traefik,
    # which has no admission webhook and is already running before helmfile starts.
    needs:
      - ingress-nginx/ingress-nginx
{{- end }}

  # OpenTelemetry Operator — reconciles the OpenTelemetryCollector CR that the
  # debezium-platform chart creates when monitoring.otel.enabled=true. On the public
  # profile cert-manager issues the operator's admission-webhook certs, so the chart is
  # left at its default. Everywhere else there is no cert-manager and the chart would
  # emit a cert-manager Issuer + Certificate the cluster cannot resolve, so
  # values/opentelemetry-operator/self-signed.yaml switches the webhook to a
  # self-signed auto-generated cert instead.
  - name: opentelemetry-operator
    namespace: monitoring
    createNamespace: true
    chart: open-telemetry/opentelemetry-operator
    version: '{{ requiredEnv "DPL_OTEL_OPERATOR_VERSION" }}'
    installed: true
    labels:
      app: opentelemetry-operator
      component: monitoring
      infra: "true"
{{- if $public }}
    # cert-manager being in the release list is not the same as it being in the cluster.
    # Without this edge both land in the first concurrent wave, and helm validates the
    # rendered manifest against API discovery before installing anything — so the Issuer
    # and Certificate above fail with `no matches for kind "Certificate"` seconds into a
    # run whose cert-manager release goes on to succeed half a minute later. Only bites
    # on a cluster that has never had cert-manager, which is why re-running looks like a
    # fix. Gated on $public for the same reason as kube-prometheus-stack's edge above:
    # an edge to a release that is not installed is not reliably a no-op.
    needs:
      - cert-manager/cert-manager
{{- end }}
{{- if not $public }}
    values:
      - values/opentelemetry-operator/self-signed.yaml
{{- end }}

  # Identity / SSO — selected with components.sso, which the guard at the top of this
  # file pins to DPL_ENV=public. Keycloak via the official Operator, treated as durable
  # infra (installed once, upgraded in place; not part of the platform churn).
  # Three releases in the `identity` namespace, chained by needs:
  #   keycloak-operator  -> official operator + CRDs, vendored by
  #                         scripts/vendor-keycloak-operator.sh (pinned version).
  #   keycloak-db        -> a DEDICATED CNPG Postgres, separate from the demo
  #                         `databases` cluster so a platform rebuild never wipes
  #                         Keycloak's identity data. Needs cnpg-operator.
  #   keycloak           -> the Keycloak CR + nginx Ingress (edge TLS from the
  #                         wildcard cert) + identity-namespace Certificate + a
  #                         starter dmp realm. Needs the operator (CRDs) and DB.
  # First install: the operator CRDs are large; if Helm hits the client-side
  # "metadata.annotations: Too long" limit, apply them once with
  #   kubectl apply --server-side -f deploy/charts/keycloak-operator/crds/
  - name: keycloak-operator
    namespace: identity
    createNamespace: true
    chart: ./charts/keycloak-operator
    installed: {{ $sso }}
    timeout: 300
    labels:
      app: keycloak-operator
      component: identity
      infra: "true"

  - name: keycloak-db
    namespace: identity
    createNamespace: true
    chart: ./charts/keycloak-db
    installed: {{ $sso }}
    timeout: 300
    labels:
      app: keycloak-db
      component: identity
      infra: "true"
    needs:
      - databases/cnpg-operator

  - name: keycloak
    namespace: identity
    createNamespace: true
    chart: ./charts/keycloak
    installed: {{ $sso }}
    timeout: 600
    # Do NOT roll back on failure: this release includes a cert-manager Certificate,
    # and helm --wait blocks on it. If issuance lags (DNS-01) past the timeout, the
    # default rollback-on-failure would UNINSTALL an otherwise-healthy Keycloak
    # (Keycloak CR Ready, realm imported) just because the cert wasn't ready yet.
    # atomic:false leaves the resources in place so a slow cert can catch up.
    atomic: false
    labels:
      app: keycloak
      component: identity
      infra: "true"
    values:
      - values/keycloak/{{ $env }}.yaml.gotmpl
    needs:
      - identity/keycloak-operator
      - identity/keycloak-db

  # SSO Phase 3 — oauth2-proxy fronts dmp.${DPL_DOMAIN} (stage UI + conductor /api) as a
  # full REVERSE PROXY, not ForwardAuth: it owns the host's Ingress and proxies to the two
  # upstreams itself, handing the conductor a bearer it validates as an OIDC resource
  # server. Temporary bridge until stage speaks OIDC natively.
  # needs keycloak: oauth2-proxy fetches the realm's OIDC discovery at startup and won't go
  # Ready until it resolves. atomic:false so a transient discovery/cert lag doesn't uninstall
  # an otherwise-healthy proxy (same reasoning as the keycloak stanza).
  - name: oauth2-proxy
    namespace: identity
    createNamespace: true
    chart: oauth2-proxy/oauth2-proxy
    version: '{{ requiredEnv "DPL_OAUTH2_PROXY_CHART_VERSION" }}'
    installed: {{ $sso }}
    timeout: 300
    atomic: false
    labels:
      app: oauth2-proxy
      component: identity
      infra: "true"
    values:
      - values/oauth2-proxy/{{ $env }}.yaml.gotmpl
    needs:
      - identity/keycloak

  # Second oauth2-proxy instance, fronting kafbat-ui exactly as the first fronts the dmp
  # host. A separate release rather than extra upstreams on the first: each instance owns
  # one Ingress host, one cookie and one redirect_url, so protecting another UI can never
  # disturb the working dmp front door. kafbat-ui itself has auth.type: disabled — this
  # release IS its authentication, which is why the two are gated together.
  - name: oauth2-proxy-kafbat
    namespace: identity
    createNamespace: true
    chart: oauth2-proxy/oauth2-proxy
    version: '{{ requiredEnv "DPL_OAUTH2_PROXY_CHART_VERSION" }}'
    installed: {{ and $sso $kafkaUI }}
    timeout: 300
    atomic: false
    labels:
      app: oauth2-proxy-kafbat
      component: identity
      infra: "true"
    values:
      - values/oauth2-proxy/kafbat.yaml.gotmpl
    # keycloak only: the proxy resolves OIDC discovery at startup, but reaches its
    # upstream per-request, so it does not need kafbat-ui to be Ready first.
    needs:
      - identity/keycloak

  - name: debezium-operator
    namespace: '{{ env "DPL_NAMESPACE" | default "dmp" }}'
    createNamespace: true
    installed: {{ not $bundledOperator }}
    chart: debezium/debezium-operator
    version: '{{ requiredEnv "DPL_DEBEZIUM_VERSION" }}'
    labels:
      app: debezium-operator
      component: operator
    # The operator image is pinned independently of the chart version (DPL_DEBEZIUM_VERSION).
    # The platform (conductor/stage) only publishes arm64 on `nightly`, so on the
    # arm64 lab box we must run nightly conductor/stage — and the operator +
    # its DebeziumServer CRD must match that nightly line, or the operator fails to
    # deserialize the CRs the nightly conductor emits (e.g. runtime.metrics.otel
    # metricExportIntervalMs, added after 3.6.0). Vendor the matching nightly CRD via
    # scripts (see docs). Default nightly; override with DPL_DEBEZIUM_OPERATOR_TAG.
    set:
      - name: image
        value: quay.io/debezium/operator:{{ env "DPL_DEBEZIUM_OPERATOR_TAG" | default "nightly" }}

  - name: debezium-platform
    namespace: '{{ env "DPL_NAMESPACE" | default "dmp" }}'
    createNamespace: true
    # Vendored from the debezium-platform repo's helm/ (branch build) rather than the
    # published debezium/debezium-platform chart, because it carries the conductor.oidc
    # block the SSO demo needs (not yet in the released chart). Re-sync from
    # ../debezium-platform/helm when that lands upstream, then switch back to the repo
    # chart + DPL_DEBEZIUM_VERSION. Local path ⇒ no version pin (Chart.yaml is 0.0.1).
    chart: ./charts/debezium-platform
    needs:
      - monitoring/kube-prometheus-stack
      - monitoring/opentelemetry-operator
    labels:
      app: debezium-platform
      component: platform
    values:
      - values/dmp/{{ env "DPL_ENV" | default "local" }}.yaml.gotmpl
    set:
      - name: conductor.image
        value: {{ env "DPL_IMAGE_REGISTRY_CONDUCTOR" | default "quay.io" }}/debezium/platform-conductor:{{ env "DPL_IMAGE_TAG_CONDUCTOR" | default "nightly" }}
      - name: stage.image
        value: {{ env "DPL_IMAGE_REGISTRY" | default "quay.io" }}/debezium/platform-stage:{{ env "DPL_IMAGE_TAG" | default "nightly" }}
      - name: conductor.descriptors.official.tag
        value: {{ env "DPL_IMAGE_TAG" | default "nightly" }}
      - name: debezium-operator.enabled
        value: {{ $bundledOperator }}
      # The bundled subchart carries `image: quay.io/debezium/operator:3.2.0.Beta1` in its
      # own values.yaml, and nothing here overrode it — so DPL_DEBEZIUM_OPERATOR_TAG, which
      # the standalone debezium-operator release above already honours, was inert in bundled
      # mode. Bundled is the DEFAULT, which is how the operator ends up on a beta while
      # conductor and stage track nightly: exactly the skew the comment on that release warns
      # about. Set here so both operator modes read the same variable.
      #
      # `app.image` is a FLAT STRING in this subchart (the template renders
      # `image: {{ "{{" }} .Values.app.image }}`), not the usual repository/tag map. Setting
      # `.app.image.tag` would pass the subchart's values.schema.json — it declares only
      # watchNamespaces and does not forbid extra keys — and then render
      # `image: map[tag:nightly]`, which fails at pull time rather than at template time.
      # Override the whole reference. Note the key was a bare `image` up to 3.2.0-beta1 and
      # moved under `app` in the 3.7.0 line; a stale `debezium-operator.image` here would be
      # silently ignored rather than rejected.
      - name: debezium-operator.app.image
        value: quay.io/debezium/operator:{{ env "DPL_DEBEZIUM_OPERATOR_TAG" | default "nightly" }}
      # The operator image ships the Quarkus OpenTelemetry extension ENABLED and exports its
      # OWN metrics — JVM, reconcile counts — independently of the pipeline metrics that
      # monitoring.otel.enabled configures on conductor. The chart's default endpoint is the
      # placeholder `http://otel-collector:4317`, which resolves nowhere here, so a
      # PeriodicMetricReader failed every 60s for the life of the pod and that telemetry was
      # dropped on the floor. Point it at the collector the platform already runs.
      #
      # Port 4317, not conductor's 4318: this chart sets no protocol variable, so the exporter
      # stays on its Quarkus default of OTLP/gRPC. The collector's CR enables both receivers.
      # 3.2.0-beta1 had no env values at all — the endpoint could not be configured through
      # Helm, only by patching the Deployment — which is the main reason the subchart pin
      # above moved to the 3.7.0 line rather than staying on the beta.
      - name: debezium-operator.app.envs.QUARKUS_OTEL_EXPORTER_OTLP_ENDPOINT
        value: http://debezium-platform-otel-collector-collector.{{ env "DPL_NAMESPACE" | default "dmp" }}.svc.cluster.local:4317
