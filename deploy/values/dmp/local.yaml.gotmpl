domain:
  name: dmp.{{ requiredEnv "DPL_DOMAIN" }}
database:
  enabled: true
ingress:
  className: nginx
debezium-operator:
  enabled: true
conductor:
  imagePullPolicy: IfNotPresent
stage:
  imagePullPolicy: IfNotPresent
monitoring:
  otel:
    enabled: true
    collector:
      image: ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector:{{ requiredEnv "DPL_OTEL_OPERATOR_VERSION" }}
  prometheus:
    # Conductor queries this Prometheus HTTP API to render its in-UI panels.
    url: "http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090"
    serviceMonitor:
      enabled: true
      labels:
        release: kube-prometheus-stack
