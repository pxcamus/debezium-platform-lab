# Debezium Platform on OpenShift (CRC or SNO), DPL_ENV=ocp.
#
# What is different from local/public:
#   - No bundled Postgres. The chart's database subchart runs quay.io/debezium/postgres
#     as root, which restricted-v2 rejects. The conductor DB is a CloudNativePG cluster
#     named conductor-db (operator from OperatorHub), reached through its -rw Service
#     and the -app Secret CNPG creates (keys: username, password).
#   - Ingress with no class. OpenShift's router admits classless Ingress objects and
#     creates a Route for them. Plain HTTP on CRC (DPL_DOMAIN=apps-crc.testing).
#   - Monitoring uses what OpenShift already has: User Workload Monitoring scrapes the
#     ServiceMonitor (no release label needed), and the Red Hat build of OpenTelemetry
#     from OperatorHub reconciles the OpenTelemetryCollector. The helmfile releases for
#     kube-prometheus-stack and opentelemetry-operator are gated off on ocp.
domain:
  name: dmp.{{ requiredEnv "DPL_DOMAIN" }}
database:
  enabled: false
  host: conductor-db-rw
  name: conductor
  auth:
    existingSecret: conductor-db-app
stage:
  imagePullPolicy: Always
conductor:
  imagePullPolicy: Always
# Image for the Debezium Server pods the conductor creates per pipeline. Empty means the
# operator's default, quay.io/debezium/server:nightly. Pinned to a release because the
# 3.8.0-SNAPSHOT nightly (2026-11-09) dies at startup when JMX_EXPORTER_PORT is set:
# IllegalAccessError in jmx_prometheus_javaagent 1.0.1 against prometheus-metrics 1.5.1,
# and the conductor always enables the JMX exporter. Remove once the nightly bumps the
# agent. Pipelines pick the image up on their next create or update.
server:
  image: quay.io/debezium/server:3.7.1.Final
monitoring:
  otel:
    enabled: true
    collector:
      # The Red Hat operator's default collector image has no `nop` exporter, which the
      # chart's logs/traces pipelines use, so the collector refuses its config. The
      # upstream core distribution ships nop + prometheus. Remove once
      # <your dbz issue> is fixed in the chart.
      image: ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector:0.165.0
  prometheus:
    # Conductor's in-UI panels query this URL with a plain, unauthenticated HTTP client.
    # OpenShift's user-workload Prometheus only listens on 127.0.0.1:9090 in its pod and is
    # exposed on 9091 behind kube-rbac-proxy (TLS + token), which the conductor cannot use.
    # So the panels read from a small plain-HTTP Prometheus in the dmp namespace that scrapes
    # the OTel collector (manifest: deploy/manifests/ocp/dmp-prometheus.yaml, applied by
    # hand with oc apply). Metrics still reach the cluster Prometheus via the ServiceMonitor.
    # Remove once the conductor supports bearer-token/TLS (feature request upstream).
    url: "http://dmp-prometheus.dmp.svc:9090"
    serviceMonitor:
      enabled: true
      labels: {}
