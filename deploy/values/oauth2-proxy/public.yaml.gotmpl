# oauth2-proxy — public. Rendered by helmfile with the environment loaded.
# Runs as the reverse proxy IN FRONT of the whole dmp.${DPL_DOMAIN} host. Unauthenticated
# requests get an automatic 302 to Keycloak — no Traefik errors-middleware / cross-namespace
# dance that ForwardAuth would otherwise need just to redirect on 401. After login it proxies
# /api -> conductor (injecting Authorization: Bearer so the conductor resource server validates
# it) and everything else -> stage. The chart's own conductor-ingress is disabled (see
# values/dmp/homelab.yaml.gotmpl) so this is the single front door. Temporary bridge until stage
# speaks OIDC natively — see the SSO runbook.

# client-id/secret + cookie-secret come from a hand-created, git-ignored Secret in identity:
#   kubectl -n identity create secret generic oauth2-proxy-secret \
#     --from-literal=client-id=oauth2-proxy \
#     --from-literal=client-secret='<keycloak oauth2-proxy client secret>' \
#     --from-literal=cookie-secret="$(openssl rand -base64 24)"
# cookie-secret must be a 16/24/32-BYTE string (used verbatim): `-base64 24` = 32 chars. NOT
# `-base64 32` (= 44, fails).
config:
  existingSecret: oauth2-proxy-secret
  # A full legacy config file takes precedence over the chart's auto-generated cfg, so the two
  # path-routed upstreams are unambiguous. client-id/secret/cookie-secret still arrive as env
  # from existingSecret. Ports: conductor Service :8080 (/api), stage Service :3000 (everything else).
  configFile: |-
    provider = "oidc"
    oidc_issuer_url = "https://auth.{{ requiredEnv "DPL_DOMAIN" }}/realms/dmp"
    redirect_url = "https://dmp.{{ requiredEnv "DPL_DOMAIN" }}/oauth2/callback"
    email_domains = ["*"]
    # Homelab realm users (thorin, …) are test accounts with unverified emails; don't reject
    # them on the email_verified claim. Drop this once users have verified emails / real IdP.
    insecure_oidc_allow_unverified_email = true
    cookie_domains = [".{{ requiredEnv "DPL_DOMAIN" }}"]
    cookie_secure = true
    whitelist_domains = [".{{ requiredEnv "DPL_DOMAIN" }}"]
    reverse_proxy = true
    # pass_authorization_header (NOT set_authorization_header) injects Authorization: Bearer
    # <id_token> into the UPSTREAM request so the conductor resource server validates it.
    # set_authorization_header only sets it on the auth RESPONSE (forward-auth mode) — useless here.
    pass_authorization_header = true
    skip_provider_button = true
    # conductor path has a trailing slash so it's a subtree (prefix) match — "/api" without
    # it is an exact match and /api/pipelines falls through to the stage "/" upstream.
    upstreams = [
      "http://conductor.{{ env "DPL_NAMESPACE" | default "dmp" }}.svc.cluster.local:8080/api/",
      "http://stage.{{ env "DPL_NAMESPACE" | default "dmp" }}.svc.cluster.local:3000/"
    ]

# Single front door for the dmp host (path / catches everything; oauth2-proxy serves /oauth2/*
# internally and reverse-proxies the rest). Lives in identity, reusing the wildcard cert the
# keycloak release materialized there.
ingress:
  enabled: true
  className: traefik
  path: /
  pathType: Prefix
  hosts:
    - dmp.{{ requiredEnv "DPL_DOMAIN" }}
  tls:
    - secretName: wildcard-{{ requiredEnv "DPL_DOMAIN" | replace "." "-" }}-tls
      hosts:
        - dmp.{{ requiredEnv "DPL_DOMAIN" }}
