{
  "name": "${DPL_DMP_RESOURCE_PREFIX}-${DPL_DMP_ENVIRONMENT}-sqlserver",
  "type": "SQLSERVER",
  "config": {
    "hostname": "${DPL_DMP_SQLSERVER_HOSTNAME}",
    "port": 1433,
    "username": "${DPL_DMP_SQLSERVER_USERNAME}",
    "password": "${DPL_DMP_SQLSERVER_PASSWORD}",
    "database": "${DPL_DMP_SQLSERVER_DATABASE}",
    "encrypt": "${DPL_DMP_SQLSERVER_ENCRYPT}",
    "trustServerCertificate": "${DPL_DMP_SQLSERVER_TRUST_SERVER_CERTIFICATE}"
  }
}