# Copy to .env at the REPO ROOT. Pairs with components.yaml in this directory, which selects WHAT
# gets installed; this file configures HOW.

# Profile: OpenShift Local (crc). The cluster's own router, monitoring and OperatorHub
# operators are used, so this profile installs no ingress controller, no Prometheus
# stack and no operators of its own.
DPL_ENV=ocp

# The apps domain of the cluster. On crc this is fixed and already resolves on the
# host, so there is no DNS record to create and no certificate to issue: the platform
# is served over plain HTTP at http://dmp.apps-crc.testing.
DPL_DOMAIN=apps-crc.testing
DPL_NAMESPACE=dmp
