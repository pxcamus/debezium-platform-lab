# Copy to .env at the REPO ROOT. Pairs with components.yaml in this directory, which selects WHAT
# gets installed; this file configures HOW.

# Profile: real cluster, real domain, cert-manager-issued TLS. The other value
# is `local` (Kind, no TLS, ingress-nginx) — the SSO chain refuses to render on it.
DPL_ENV=ocp

# The zone everything hangs off: auth.<domain>, dmp.<domain>, kafbat.<domain>.
# Must be a zone whose DNS you control — cert-manager proves ownership by writing
# a TXT record into it. Use a subdomain, not your apex: the wildcard is
# single-level, so *.demo.example.com covers auth.demo.example.com but
# *.example.com does not. Point an A record for *.<domain> at your node's IP.
DPL_DOMAIN=apps-crc.testing
DPL_NAMESPACE=dmp
