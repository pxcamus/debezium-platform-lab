# Copy to .env at the REPO ROOT. Pairs with components.yaml in this directory, which selects WHAT
# gets installed; this file configures HOW.

# Profile: real cluster, real domain, cert-manager-issued TLS. The other value
# is `local` (Kind, no TLS, ingress-nginx) — the SSO chain refuses to render on it.
DPL_ENV=public

# Only read by `just cluster-recreate` to decide which provisioner to call.
# kind | k3s. Irrelevant if you already have a cluster.
DPL_CLUSTER_TYPE=k3s

# The zone everything hangs off: auth.<domain>, dmp.<domain>, kafbat.<domain>.
# Must be a zone whose DNS you control — cert-manager proves ownership by writing
# a TXT record into it. Use a subdomain, not your apex: the wildcard is
# single-level, so *.demo.example.com covers auth.demo.example.com but
# *.example.com does not. Point an A record for *.<domain> at your node's IP.
DPL_DOMAIN=demo.example.com

# Let's Encrypt account identity. Expiry warnings go here, so use a real address.
DPL_ACME_EMAIL=you@example.com

# Gandi Personal Access Token with DNS write scope on the zone above. Becomes the
# gandi-credentials Secret the DNS-01 webhook authenticates with. Only needed if
# components.yaml has dns01-gandi: true — on another registrar, drop this and
# supply your own ClusterIssuer named letsencrypt-prod.
# .env is git-ignored; this file is the committed template, so keep it a placeholder.
DPL_GANDI_PAT=your_gandi_personal_access_token